# Copy to .env (gitignored) and fill only the providers you enable in profile/preferences.json.
# Keys are read by the gaj CLI and never written to data/ or printed.

# Google for Jobs via SerpAPI: https://serpapi.com (free tier available)
SERPAPI_API_KEY=

# Google for Jobs via JSearch on RapidAPI: https://rapidapi.com (free tier available)
JSEARCH_RAPIDAPI_KEY=

# Apify actors (LinkedIn/Indeed/Naukri scrapers): https://apify.com (free monthly credit)
APIFY_TOKEN=
